@startuml InjectionDependancesLog
skinparam classAttributeIconSize 0
skinparam handwritten true
skinparam class {
    BackgroundColor White
    BorderColor #000
}

IJournalisation <|.. JournalisationConsole
IJournalisation <|.. JournalisationFichier


UneClasse ..> IJournalisation
class UneClasse {
    + ctor(p_journalisation : IJournalisation)
    + Foo()
}

interface IJournalisation {
    + Ecrire(p_message : string)
}

class JournalisationConsole {
    + Ecrire(p_message : string) <<override>>
}

class JournalisationFichier {
    + Ecrire(p_message : string) <<override>>
}

@enduml